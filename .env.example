# =============================================================================
# BEACON — Banking Early-Alert Comprehensive Observation Network
# Configuration reference. Every variable below is read by the code or by
# docker-compose.yml; the reading site is named so stale entries cannot
# accumulate again (the 2026-09 hygiene round found this file documenting
# 6 of the ~20 variables the stack actually consumes).
#
# Setup:  cp .env.example .env && edit, then docker compose up -d
# This file must never be committed with values (.gitignore covers .env).
# =============================================================================

# --- Data-provider API keys (all optional) -----------------------------------
# ECB, BIS, IMF, World Bank and FDIC need no key. Keys can also be set later
# via the GUI Configuration page (stored per data source in the database).

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Alpha Vantage — https://www.alphavantage.co/support/#api-key (free tier limits)
ALPHA_VANTAGE_API_KEY=
# SEC EDGAR — public access works without a key; pro tier via sec-api
SEC_API_KEY=
# Financial Modeling Prep — read directly by backend/plugins/fmp_plugin.py
FMP_API_KEY=

# --- Database (docker-compose.yml interpolates these) ------------------------
# The postgres service runs TimescaleDB (PostgreSQL 15 + extension); hypertables
# are created by the timescale_001 Alembic migration. CHANGE FOR PRODUCTION.
POSTGRES_DB=beacon_db
POSTGRES_USER=beacon_user
POSTGRES_PASSWORD=beacon_password

# Direct URL override for backend/worker when not using compose interpolation
# (read by backend/database.py). SQLite fallback for local dev/tests:
#   USE_SQLITE=true            -> sqlite:///./beacon.db
#   DATABASE_URL=sqlite:///…   -> explicit URL
# DATABASE_URL=
# USE_SQLITE=false

# --- Redis / Celery -----------------------------------------------------------
# Read by backend/tasks/celery_app.py; compose defaults to redis:6379.
# REDIS_URL=redis://redis:6379/0

# --- CORS (backend/api/main.py) -----------------------------------------------
# Comma-separated origins. Compose defaults to the local frontend ports.
# ALLOWED_ORIGINS=http://localhost:9876,http://localhost:5173
# ALLOW_CREDENTIALS=true

# --- Storage paths -------------------------------------------------------------
# Where pipeline/job artefacts land inside the containers (compose mounts
# ./data at /app/data). PIPELINE_DATA_DIR is read by backend/api/routes/pipeline.py.
# PIPELINE_DATA_DIR=/app/data/pipelines
# Point-in-time bilateral exposure matrices (backend/services/bilateral_exposure_store.py):
# BILATERAL_EXPOSURE_DIR=/app/data/exposures
# Upload guards (refuse oversized matrices rather than OOM the worker):
# BILATERAL_EXPOSURE_MAX_BYTES=104857600
# BILATERAL_EXPOSURE_MAX_ROWS=50000
# BILATERAL_EXPOSURE_MAX_INSTITUTIONS=2000

# --- Model security (fail-closed overrides) ------------------------------------
# Checkpoints load with torch.load(weights_only=True). Legacy checkpoints are
# rejected unless this is 1; the override is logged as a security event.
# BEACON_ALLOW_UNSAFE_CHECKPOINT_LOAD=0
# Scoring without ANY trained checkpoint fails closed (PredictionBlockedError).
# Set 1 only for smoke tests that accept meaningless untrained output.
# BEACON_ALLOW_UNTRAINED_FALLBACK=0
# The data-quality gate refuses unverified payloads outside dev environments;
# BEACON_ENV/ENVIRONMENT=production makes the override refuse as well.
# BEACON_ALLOW_UNVERIFIED_DATA=0
# BEACON_ENV=production

# --- Misc -----------------------------------------------------------------------
# Optional YAML overlay for platform config (backend/services/config_service.py).
# CONFIG_PATH=
# Test-only: scope docker-compose-dependent integration tests.
# DOCKER_COMPOSE_CMD=docker compose
# RUN_DOCKER_SCOPE_TESTS=0

# =============================================================================
# PRODUCTION CHECKLIST
#   - strong random passwords:            openssl rand -base64 32
#   - keep .env out of version control    (it is gitignored)
#   - rotate provider keys on schedule
#   - leave the three BEACON_ALLOW_* overrides at 0
# =============================================================================
