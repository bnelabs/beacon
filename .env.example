# =============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file:  cp .env.example .env
# 2. Edit .env and add your API keys (optional - can configure via GUI later)
# 3. Start BEACON:    ./scripts/start.sh
# =============================================================================

# =============================================================================
# API KEYS (Optional - Can be configured via GUI after startup)
# =============================================================================

# FRED (Federal Reserve Economic Data)
# Get your free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Provides access to 500,000+ economic time series
FRED_API_KEY=

# Alpha Vantage (Market Data)
# Get your free key: https://www.alphavantage.co/support/#api-key
# Note: Free tier has rate limits (see documentation)
ALPHA_VANTAGE_API_KEY=

# SEC EDGAR (Corporate Filings)
# Optional - SEC provides public access without API key
# Pro version: https://www.sec.gov/edgar/sec-api-documentation
SEC_API_KEY=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database Settings
# Default values work out-of-the-box for local development
# IMPORTANT: Change these for production deployments!

POSTGRES_DB=beacon_db
POSTGRES_USER=beacon_user
POSTGRES_PASSWORD=beacon_password

# =============================================================================
# SECURITY WARNING
# =============================================================================

# ⚠️ PRODUCTION DEPLOYMENT:
#   - Use strong, randomly generated passwords
#   - Store .env securely (never commit to version control)
#   - Consider using Docker secrets or environment-specific configs
#   - Rotate API keys and passwords regularly
#
# Example strong password generation:
#   openssl rand -base64 32

# =============================================================================
# NOTES
# =============================================================================

# • API keys are optional - BEACON works without them using free data sources
# • ECB, BIS, IMF, World Bank, FDIC - No API keys required
# • You can add API keys later via the BEACON GUI Configuration page
# • This file should NOT be committed to version control (.gitignore)
