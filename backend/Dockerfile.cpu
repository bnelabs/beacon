# syntax=docker/dockerfile:1.7
# CPU-only Dockerfile for macOS, Linux without GPU, and general use
# Python 3.12 is required by the pinned scientific stack (scipy 1.18,
# scikit-learn 1.9, matplotlib 3.11 all require >= 3.12/3.11).
FROM python:3.12-slim

# uv resolves and installs the pinned stack in a fraction of pip's time - the
# dominant cost when building this image (torch alone is ~200 MB of wheels).
# Copied from the official image rather than pip-installed to avoid a second
# Python package manager in the layer.
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements file first (for better Docker layer caching)
COPY requirements.txt .

# Install Python packages into the system interpreter.
# UV_COMPILE_BYTECODE keeps application start-up fast. The uv cache is a BuildKit
# cache mount rather than a layer: it is keyed by path, not by layer hash, so the
# downloaded wheels survive even a base-image change and rebuilds do not re-fetch
# several hundred MB of torch.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.txt

# Copy backend application code to backend/ subdirectory
COPY . backend/

# Create necessary directories
RUN mkdir -p /app/data /app/results /app/logs /app/saved_models

# Create non-root user for security
RUN groupadd -r beacon && useradd -r -g beacon -u 1000 -m -d /home/beacon beacon

# Create cache directories for yfinance
RUN mkdir -p /home/beacon/.cache/py-yfinance && \
    chown -R beacon:beacon /home/beacon

# Set ownership
RUN chown -R beacon:beacon /app /home/beacon

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONIOENCODING=utf-8

# Switch to non-root user
USER beacon

# Expose port
EXPOSE 3456

# Default command (can be overridden in docker-compose)
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "3456"]
