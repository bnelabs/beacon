# CPU-only Dockerfile for macOS, Linux without GPU, and general use
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python -m pip install --upgrade pip

# Copy requirements file first (for better Docker layer caching)
COPY requirements.txt .

# Install Python packages (CPU versions)
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code to backend/ subdirectory
COPY . backend/

# Create necessary directories
RUN mkdir -p /app/data /app/results /app/logs /app/saved_models

# Create non-root user for security
RUN groupadd -r beacon && useradd -r -g beacon -u 1000 -m -d /home/beacon beacon

# Create cache directories for yfinance
RUN mkdir -p /home/beacon/.cache/py-yfinance && \
    chown -R beacon:beacon /home/beacon

# Set ownership
RUN chown -R beacon:beacon /app /home/beacon

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONIOENCODING=utf-8

# Switch to non-root user
USER beacon

# Expose port
EXPOSE 3456

# Default command (can be overridden in docker-compose)
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "3456"]
