data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
logs/*.log
*.log

# Model artifacts
models/saved/*.pth
models/saved/*.pt
!models/saved/.gitkeep

# Results
results/backtests/*.csv
results/backtests/*.html
results/dashboards/*.html
!results/backtests/.gitkeep
!results/dashboards/.gitkeep

# Docker
# `.dockerignore` was listed here from the original restructure, which is why the
# repository never had one. It is not an artefact: it is build configuration that
# decides what enters the image context, so it has to be tracked for a build to be
# reproducible anywhere but on the machine that happened to write it.
!.dockerignore

# Database
*.db
*.sqlite
*.sqlite3
# the shared SQLite file backend.database binds under USE_SQLITE=true
beacon.db

# Redis dump
dump.rdb

# Node.js (frontend)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.pnp
frontend/.pnp.js
frontend/coverage/

# Playwright output. `npx playwright test` writes traces, screenshots and an
# HTML report here on every run; committing them would add megabytes of binary
# per failure.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/


# Frontend environment
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Frontend logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/lerna-debug.log*
data/predictions/*
