# API Keys (Optional - can be configured via GUI)
# Get your free API keys from the providers below

# Federal Reserve Economic Data
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage (Stock market data)
# Sign up: https://www.alphavantage.co/support/#api-key
# Free tier: 5 calls/minute, 500/day
ALPHA_VANTAGE_API_KEY=

# SEC Edgar Filings (Company financial data)
# Sign up: https://sec-api.io
# Free tier: 100 requests/month
SEC_API_KEY=

# Database Configuration (for production deployment)
POSTGRES_DB=finai_db
POSTGRES_USER=finai_user
POSTGRES_PASSWORD=finai_password
